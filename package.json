{
  "name": "global-talent-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "db:generate": "bun --env-file=.dev.vars run drizzle-kit generate",
    "db:migrate": "bun --env-file=.dev.vars run drizzle-kit migrate",
    "db:push": "bun --env-file=.dev.vars run drizzle-kit push",
    "db:studio": "bun --env-file=.dev.vars run drizzle-kit studio",
    "export:candidate": "bun --env-file=.dev.vars scripts/export-candidate.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.133.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.3",
    "motion": "^12.23.24",
    "nitro": "3.0.260903-beta",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "workflow": "5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@tanstack/router-plugin": "^1.133.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^4.5.0"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
