{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global-talent-uk",
  "main": "src/index.tsx",
  "compatibility_date": "2025-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT",
      "id": "c8596e0941864bb38cd3509217ef9a01"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "TALENT_API_URL": "https://global-talent-radar.tom-839.workers.dev"
  }
}
