{
  "name": "global-talent-uk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-assets": "bun scripts/copy-assets.ts",
    "dev": "bun run copy-assets && wrangler dev -c wrangler.jsonc --port 8788",
    "deploy": "bun run copy-assets && wrangler deploy -c wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types -c wrangler.jsonc --env-interface CloudflareBindings",
    "export-content": "bun scripts/export-content.ts WEBSITE_CONTENT.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "govuk-frontend": "^6.5.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
