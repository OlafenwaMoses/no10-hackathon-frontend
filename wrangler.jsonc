{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global-talent-radar",
  "main": "src/api/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-12-30",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "workflows": [
    {
      "name": "talent-search",
      "binding": "SEARCH_WORKFLOW",
      "class_name": "SearchWorkflow",
    },
    {
      "name": "talent-candidate",
      "binding": "CANDIDATE_WORKFLOW",
      "class_name": "CandidateWorkflow",
    },
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
  },
  "limits": {
    "cpu_ms": 60000,
  },
  "workers_dev": true,
}
